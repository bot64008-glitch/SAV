function MenuLib.new(opts)
	opts = opts or {}
	local self = setmetatable({}, MenuLib)
	self.Alive = true
	self.Conns = {}
	self.Tabs = {}
	self.Flags = {}
	self.Refreshers = {}
	self.Callbacks = {}
	self.SaveFile = opts.SaveFile
	self.LogoId = opts.LogoId
	self.OnClose = opts.OnClose
	self.OnDestroy = nil
	self._saveQueued = false

	local name = opts.Name or "MenuLibGUI"
	local width = opts.Width or 268
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local parent = playerGui
	do
		local ok, hui = pcall(function() return gethui() end)
		if ok and hui then parent = hui end
	end
	for _, p in ipairs({ playerGui, parent }) do
		local old = p:FindFirstChild(name)
		if old then old:Destroy() end
	end

	local cam = workspace.CurrentCamera
	local viewH = cam and cam.ViewportSize.Y or 600
	local height = opts.Height or math.clamp(viewH - 60, 240, 360)

	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 999
	gui.Parent = parent
	self.Gui = gui

	local main = Instance.new("Frame")
	main.Name = "Main"
	main.Size = UDim2.fromOffset(width, height)
	main.Position = opts.Position or UDim2.new(0, 10, 0, 8)
	main.BackgroundColor3 = C.bg
	main.BorderSizePixel = 0
	main.ClipsDescendants = true
	main.Parent = gui
	Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)
	do
		local stroke = Instance.new("UIStroke", main)
		stroke.Color = C.line
		stroke.Thickness = 1
	end
	self.Main = main

	-- Шапка
	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, HEADER_H)
	header.BackgroundTransparency = 1
	header.Parent = main
	self.Header = header

	local textX = 10
	if self.LogoId then
		local logo = Instance.new("ImageLabel")
		logo.Size = UDim2.fromOffset(28, 28)
		logo.Position = UDim2.fromOffset(10, (HEADER_H - 28) / 2)
		logo.BackgroundColor3 = C.card
		logo.BorderSizePixel = 0
		logo.ScaleType = Enum.ScaleType.Fit
		logo.Parent = header
		Instance.new("UICorner", logo).CornerRadius = UDim.new(0, 7)
		applyIcon(logo, self.LogoId)
		textX = 46
	end

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(textX, 6)
	title.Size = UDim2.fromOffset(100, 16)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 13
	title.TextColor3 = C.text
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.Text = opts.Title or "WEB VALLEY"
	title.Parent = header

	local subtitle = Instance.new("TextLabel")
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromOffset(textX, 23)
	subtitle.Size = UDim2.fromOffset(100, 12)
	subtitle.Font = Enum.Font.GothamMedium
	subtitle.TextSize = 9
	subtitle.TextColor3 = C.yellow
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.TextTruncate = Enum.TextTruncate.AtEnd
	subtitle.Text = opts.Subtitle or "STUDIO"
	subtitle.Parent = header
	self.TitleLabel, self.SubtitleLabel = title, subtitle

	if opts.ShowFPS ~= false then
		local fps = Instance.new("TextLabel")
		fps.BackgroundTransparency = 1
		fps.AnchorPoint = Vector2.new(1, 0.5)
		fps.Position = UDim2.new(1, -72, 0.5, 0)
		fps.Size = UDim2.fromOffset(46, 16)
		fps.Font = Enum.Font.GothamMedium
		fps.TextSize = 11
		fps.TextColor3 = C.sub
		fps.TextXAlignment = Enum.TextXAlignment.Right
		fps.Text = "-- FPS"
		fps.Parent = header
		self.FpsLabel = fps
		self.Fps = 60
		local frames, acc = 0, 0
		self:Track(RunService.RenderStepped:Connect(function(dt)
			frames += 1
			acc += dt
			if acc >= 0.5 then
				self.Fps = frames / acc
				fps.Text = ("%d FPS"):format(math.floor(self.Fps + 0.5))
				frames, acc = 0, 0
			end
		end))
	end

	local minBtn = makeButton(header, "—", C.btn, C.text, UDim2.fromOffset(26, 26), self.Conns)
	minBtn.AnchorPoint = Vector2.new(1, 0.5)
	minBtn.Position = UDim2.new(1, -8, 0.5, 0)

	local closeBtn = makeButton(header, "⏻", C.btn, C.yellow, UDim2.fromOffset(26, 26), self.Conns)
	closeBtn.AnchorPoint = Vector2.new(1, 0.5)
	closeBtn.Position = UDim2.new(1, -38, 0.5, 0)

	local headerLine = Instance.new("Frame")
	headerLine.Size = UDim2.new(1, 0, 0, 1)
	headerLine.Position = UDim2.fromOffset(0, HEADER_H)
	headerLine.BackgroundColor3 = C.line
	headerLine.BorderSizePixel = 0
	headerLine.Parent = main

	-- Полоса вкладок
	local tabBar = Instance.new("Frame")
	tabBar.Position = UDim2.fromOffset(0, HEADER_H + 1)
	tabBar.Size = UDim2.new(1, 0, 0, TAB_H)
	tabBar.BackgroundTransparency = 1
	tabBar.Parent = main
	self.TabBar = tabBar

	-- Плавающая иконка (свёрнутое состояние)
	local iconFrame = Instance.new("Frame")
	iconFrame.Size = UDim2.fromOffset(46, 46)
	iconFrame.Position = main.Position
	iconFrame.BackgroundColor3 = C.bg
	iconFrame.BorderSizePixel = 0
	iconFrame.Visible = false
	iconFrame.Parent = gui
	Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(0, 12)
	do
		local s = Instance.new("UIStroke", iconFrame)
		s.Color = C.yellow
		s.Thickness = 1.5
	end
	if self.LogoId then
		local img = Instance.new("ImageLabel")
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Position = UDim2.new(0.5, 0, 0.5, 0)
		img.Size = UDim2.new(1, -10, 1, -10)
		img.BackgroundTransparency = 1
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = iconFrame
		Instance.new("UICorner", img).CornerRadius = UDim.new(0, 8)
		applyIcon(img, self.LogoId)
	else
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 1, 0)
		t.Font = Enum.Font.GothamBold
		t.TextSize = 20
		t.TextColor3 = C.yellow
		t.Text = "☰"
		t.Parent = iconFrame
	end
	self.IconFrame = iconFrame

	makeDraggable(self, header, main, nil)
	makeDraggable(self, iconFrame, iconFrame, function()
		self:SetMinimized(false)
	end)

	self:Track(minBtn.Activated:Connect(function()
		self:SetMinimized(true)
	end))
	self:Track(closeBtn.Activated:Connect(function()
		if self.OnClose then
			self.OnClose()
		else
			self:Destroy()
		end
	end))

	return self
end

function MenuLib:Track(conn)
	self.Conns[#self.Conns + 1] = conn
	return conn
end

function MenuLib:SetMinimized(v)
	if v then
		self.IconFrame.Position = self.Main.Position
		self.Main.Visible = false
		self.IconFrame.Visible = true
	else
		self.Main.Position = self.IconFrame.Position
		self.IconFrame.Visible = false
		self.Main.Visible = true
	end
end

function MenuLib:SetVisible(v)
	self.Gui.Enabled = v and true or false
end

function MenuLib:Destroy()
	if not self.Alive then return end
	self.Alive = false
	if self.OnDestroy then pcall(self.OnDestroy) end
	for _, c in ipairs(self.Conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(self.Conns)
	self.Gui:Destroy()
end

------------------------------------------------------------
-- ВКЛАДКИ
------------------------------------------------------------
function MenuLib:SelectTab(which)
	for i, t in ipairs(self.Tabs) do
		local active = (which == i) or (which == t.Name)
		t.Page.Frame.Visible = active
		t.Btn.TextColor3 = active and C.yellow or C.sub
		t.Line.Visible = active
		if active and t.Page.OnShow then
			pcall(t.Page.OnShow)
		end
	end
end

function MenuLib:AddTab(name)
	local sf = Instance.new("ScrollingFrame")
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Position = UDim2.fromOffset(0, TOP_H)
	sf.Size = UDim2.new(1, 0, 1, -TOP_H)
	sf.CanvasSize = UDim2.new(0, 0, 0, 0)
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.ScrollBarThickness = 3
	sf.ScrollBarImageColor3 = C.yellow
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.Visible = false
	sf.Parent = self.Main
	local pad = Instance.new("UIPadding", sf)
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 10)
	local list = Instance.new("UIListLayout", sf)
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder

	local page = setmetatable({ Frame = sf, n = 0, Window = self }, Page)

	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.TextColor3 = C.sub
	b.Text = name
	b.Parent = self.TabBar
	local ln = Instance.new("Frame")
	ln.AnchorPoint = Vector2.new(0.5, 1)
	ln.Position = UDim2.new(0.5, 0, 1, 0)
	ln.Size = UDim2.new(0.6, 0, 0, 2)
	ln.BackgroundColor3 = C.yellow
	ln.BorderSizePixel = 0
	ln.Visible = false
	ln.Parent = b

	local tab = { Name = name, Page = page, Btn = b, Line = ln }
	self.Tabs[#self.Tabs + 1] = tab
	local index = #self.Tabs

	-- пересчитать ширину всех кнопок вкладок
	local count = #self.Tabs
	for i, t in ipairs(self.Tabs) do
		t.Btn.Size = UDim2.new(1 / count, 0, 1, 0)
		t.Btn.Position = UDim2.new((i - 1) / count, 0, 0, 0)
	end

	self:Track(b.Activated:Connect(function()
		self:SelectTab(index)
	end))

	if index == 1 then
		self:SelectTab(1)
	end
	return page
end

------------------------------------------------------------
-- Привязка значений: способ Б (Flag + Default + Callback)
------------------------------------------------------------
function MenuLib:_bind(label, spec)
	local flag = spec.Flag or label
	if self.Flags[flag] == nil then
		self.Flags[flag] = spec.Default
	end
	self.Callbacks[flag] = spec.Callback
	local win = self
	local function get()
		return win.Flags[flag]
	end
	local function set(v)
		win.Flags[flag] = v
		if spec.Callback then spec.Callback(v) end
		win:_queueSave()
	end
	return get, set
end

function MenuLib:_queueSave()
	if not self.SaveFile or self._saveQueued then return end
	self._saveQueued = true
	task.delay(1.5, function()
		self._saveQueued = false
		if self.Alive then self:Save() end
	end)
end

function MenuLib:Save()
	if not self.SaveFile or not writefile then return end
	pcall(function()
		writefile(self.SaveFile, HttpService:JSONEncode(self.Flags))
	end)
end

-- Вызывайте ПОСЛЕ создания всех элементов: подставит сохранённые значения
-- и вызовет Callback каждого элемента.
function MenuLib:Load()
	if not self.SaveFile or not (readfile and isfile) then return end
	local ok, raw = pcall(function()
		if isfile(self.SaveFile) then return readfile(self.SaveFile) end
	end)
	if not ok or not raw then return end
	local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok2 or type(data) ~= "table" then return end
	for flag, value in pairs(data) do
		local cur = self.Flags[flag]
		if cur ~= nil and type(cur) == type(value) then
			self.Flags[flag] = value
			local cb = self.Callbacks[flag]
			if cb then pcall(cb, value) end
		end
	end
	for _, refresh in ipairs(self.Refreshers) do
		pcall(refresh)
	end
end

