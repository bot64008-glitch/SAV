------------------------------------------------------------
-- Цикл фарма
------------------------------------------------------------
local function farmLoop(my)
	local function ok()
		return S.running and token == my and Win.Alive
	end

	local collected = 0
	local homed = false

	while ok() do
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if not hrp or not hum or hum.Health <= 0 then
			status.SetStatus("Ожидание персонажа...", C.sub)
			homed = false
			task.wait(0.5)
		else
			local target, count = pickTarget(hrp.Position)
			if not target then
				if not homed then
					local hp = homePos()
					if hp then tpTo(hrp, hp) end
					homed = true
				end
				status.SetStatus(("Зона %s пуста"):format(pairLabel(S.pair)), C.text)
				status.SetInfo(("Собрано: %d · жду новые боксы"):format(collected), C.sub)
				if S.stopWhenEmpty then
					stop("Зона очищена")
					return
				end
				task.wait(0.4)
			else
				homed = false
				status.SetStatus(("Фарм %s: %s"):format(pairLabel(S.pair), target.Name), C.yellow)
				status.SetInfo(("Собрано: %d · осталось: %d"):format(collected, count), C.sub)

				local prompts, clicks = gatherInteractables(target)
				local t0 = os.clock()
				local lastFire, lastGather = 0, t0
				setE(true)

				while ok() and alive(target) and os.clock() - t0 < S.timeout do
					local c = LocalPlayer.Character
					local h = c and c:FindFirstChild("HumanoidRootPart")
					if not h then break end
					tpTo(h, target:GetPivot().Position + Vector3.new(0, S.height, 0))

					local now = os.clock()
					if S.usePrompt and now - lastFire > 0.1 then
						lastFire = now
						if now - lastGather > 1 then
							lastGather = now
							prompts, clicks = gatherInteractables(target)
						end
						if fpp then
							for _, p in ipairs(prompts) do
								if p.Parent and p.Enabled then pcall(fpp, p) end
							end
						end
						if fcd then
							for _, cd in ipairs(clicks) do
								if cd.Parent then pcall(fcd, cd) end
							end
						end
					end
					RunService.Heartbeat:Wait()
				end

				setE(false)
				if alive(target) then
					blacklist[target] = os.clock() + 20 -- завис — пропускаем на время
				else
					collected += 1
				end

				if ok() then
					local c = LocalPlayer.Character
					local h = c and c:FindFirstChild("HumanoidRootPart")
					local hp = homePos()
					if h and hp then tpTo(h, hp) end
					homed = true
					task.wait(0.15)
				end
			end
		end
	end
end

start = function()
	if S.running then return end
	S.running = true
	token += 1
	local my = token
	status.SetStatus("Запуск...", C.yellow)
	task.spawn(function() farmLoop(my) end)
end

stop = function(reason)
	S.running = false
	token += 1
	setE(false)
	status.SetStatus(reason or "Остановлено", C.sub)
end

------------------------------------------------------------
-- Кэш боксов + очистка
------------------------------------------------------------
Win:Track(Workspace.DescendantAdded:Connect(function(inst)
	if matchBox(inst) then boxes[inst] = true end
end))
Win:Track(Workspace.DescendantRemoving:Connect(function(inst)
	boxes[inst] = nil
end))
task.spawn(rebuildBoxes)

Win.OnDestroy = function()
	S.running = false
	token += 1
	rebuildId += 1
	setE(false)
end
