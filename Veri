-- Числовая строка. spec:
--   способ А: { get=, set=, step=, min=, max=, dec= }
--   способ Б: { Flag=, Default=, Callback=, Step=, Min=, Max=, Dec= }
--   step — число или функция(dir, current) -> число
function Page:AddNumber(label, spec)
	local win = self.Window
	local get, set = spec.get, spec.set
	if not get then
		get, set = win:_bind(label, spec)
	end
	local step = spec.step or spec.Step or 1
	local min = spec.min or spec.Min or 0
	local max = spec.max or spec.Max or 100
	local dec = spec.dec or spec.Dec or 0

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 32)
	row.BackgroundColor3 = C.card
	row.BorderSizePixel = 0
	row.LayoutOrder = self:_order()
	row.Parent = self.Frame
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

	local lab = Instance.new("TextLabel")
	lab.BackgroundTransparency = 1
	lab.Position = UDim2.fromOffset(10, 0)
	lab.Size = UDim2.new(1, -122, 1, 0)
	lab.Font = Enum.Font.Gotham
	lab.TextSize = 11
	lab.TextColor3 = C.text
	lab.TextXAlignment = Enum.TextXAlignment.Left
	lab.TextTruncate = Enum.TextTruncate.AtEnd
	lab.Text = label
	lab.Parent = row

	local plus = makeButton(row, "+", C.btn, C.text, UDim2.fromOffset(26, 24), win.Conns)
	plus.AnchorPoint = Vector2.new(1, 0.5)
	plus.Position = UDim2.new(1, -6, 0.5, 0)
	plus.TextSize = 15
	local minus = makeButton(row, "−", C.btn, C.text, UDim2.fromOffset(26, 24), win.Conns)
	minus.AnchorPoint = Vector2.new(1, 0.5)
	minus.Position = UDim2.new(1, -36, 0.5, 0)
	minus.TextSize = 15

	local box = Instance.new("TextBox")
	box.AnchorPoint = Vector2.new(1, 0.5)
	box.Position = UDim2.new(1, -66, 0.5, 0)
	box.Size = UDim2.fromOffset(48, 24)
	box.BackgroundColor3 = C.bg
	box.BorderSizePixel = 0
	box.Font = Enum.Font.GothamBold
	box.TextSize = 12
	box.TextColor3 = C.yellow
	box.ClearTextOnFocus = true
	box.Text = ""
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

	local function fmt(v)
		if dec > 0 then
			return ("%." .. dec .. "f"):format(v)
		end
		return tostring(math.floor(v + 0.5))
	end
	local function apply(v)
		v = math.clamp(v, min, max)
		local m = 10 ^ dec
		set(math.floor(v * m + 0.5) / m)
	end
	local function refresh()
		local v = get()
		if type(v) == "number" then
			box.Text = fmt(v)
		end
	end
	local function stepBy(dir)
		local cur = get() or min
		local st = step
		if type(st) == "function" then
			st = st(dir, cur)
		end
		apply(cur + dir * st)
		refresh()
	end

	win:Track(box.FocusLost:Connect(function()
		local n = tonumber((box.Text:gsub(",", ".")))
		if n then
			apply(n)
		end
		refresh()
	end))
	win:Track(plus.Activated:Connect(function() stepBy(1) end))
	win:Track(minus.Activated:Connect(function() stepBy(-1) end))
	refresh()
	win.Refreshers[#win.Refreshers + 1] = refresh

	return {
		Get = get,
		Set = function(v)
			apply(v)
			refresh()
		end,
		Refresh = refresh,
	}
end

