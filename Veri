--[[
    ╔══════════════════════════════════════════════════════════════════╗
    ║  BOX FARM — WEB VALLEY STUDIO                                    ║
    ║  Телепорт к предметам "box" внутри выбранного промежутка зон     ║
    ╚══════════════════════════════════════════════════════════════════╝
    Промежутки только парами: 1-2, 3-4, 5-6 ... (никаких 1-7 или 4-8).
    Точки зон вписаны вручную в таблицу POINTS ниже.
]]

local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)

local fpp = (typeof(fireproximityprompt) == "function") and fireproximityprompt or nil
local fcd = (typeof(fireclickdetector) == "function") and fireclickdetector or nil

------------------------------------------------------------
-- Настройки (состояние)
------------------------------------------------------------
local S = {
	running = false,
	pair = 1,            -- номер пары: 1 = зоны 1-2, 2 = зоны 3-4 ...
	keyword = "box",     -- часть названия предмета
	returnMode = "pair", -- "pair" = первая точка промежутка, "one" = точка 1
	stopWhenEmpty = false,
	timeout = 8,         -- лимит секунд на один бокс
	height = 2,          -- высота над боксом
	padX = 20,           -- запас промежутка вдоль X (studs)
	padYZ = 80,          -- запас в стороны и по высоте (studs)
	holdE = true,
	usePrompt = true,
}
local token = 0
local boxes = {}
local blacklist = {}
local eHeld = false

local function trim(s)
	return (tostring(s):gsub("^%s+", ""):gsub("%s+$", ""))
end

------------------------------------------------------------
-- Точки зон (X, Y, Z)
------------------------------------------------------------
local POINTS = {
	Vector3.new(157.9, 3.1, -61.4),   -- 1
	Vector3.new(249.3, 3.1, -57.7),   -- 2
	Vector3.new(403.3, 3.1, -60.4),   -- 3
	Vector3.new(634.4, 3.1, -58.1),   -- 4
	Vector3.new(961.9, 3.1, -61.7),   -- 5
	Vector3.new(1319.5, 3.1, -51.4),  -- 6
	Vector3.new(1687.4, 3.1, -64.2),  -- 7
	Vector3.new(2043.6, 3.1, -57.5),  -- 8
	Vector3.new(2475.9, 3.1, -55.3),  -- 9
	Vector3.new(3000.1, 3.1, -57.5),  -- 10
	Vector3.new(3595.7, 3.1, -56.8),  -- 11
	Vector3.new(4287.6, 3.1, -73.0),  -- 12
	Vector3.new(5052.4, 3.1, -63.6),  -- 13
}
local maxZone = #POINTS

local function addPoint(mn, mx, p)
	if not mn then return p, p end
	return Vector3.new(math.min(mn.X, p.X), math.min(mn.Y, p.Y), math.min(mn.Z, p.Z)),
		Vector3.new(math.max(mx.X, p.X), math.max(mx.Y, p.Y), math.max(mx.Z, p.Z))
end

-- пара k = точки (2k-1) и 2k; последняя непарная точка идёт одна
local function pairLabel(k)
	local a, b = 2 * k - 1, 2 * k
	if b > maxZone then return tostring(a) end
	return ("%d-%d"):format(a, b)
end

-- границы промежутка: коробка между двумя точками + запас
local function rangeBounds(k)
	local mn, mx
	for _, n in ipairs({ 2 * k - 1, 2 * k }) do
		local p = POINTS[n]
		if p then mn, mx = addPoint(mn, mx, p) end
	end
	if not mn then return nil end
	local pad = Vector3.new(S.padX, S.padYZ, S.padYZ)
	return mn - pad, mx + pad
end

local function inRange(box, k, mn, mx)
	if not mn then return false end
	local p = box:GetPivot().Position
	return p.X >= mn.X and p.X <= mx.X
		and p.Y >= mn.Y and p.Y <= mx.Y
		and p.Z >= mn.Z and p.Z <= mx.Z
end

------------------------------------------------------------
-- Поиск боксов (кэш с автообновлением)
------------------------------------------------------------
local function isPlayerPart(inst)
	for _, pl in ipairs(Players:GetPlayers()) do
		local ch = pl.Character
		if ch and (inst == ch or inst:IsDescendantOf(ch)) then return true end
	end
	return false
end

local function matchBox(inst)
	if S.keyword == "" then return false end
	if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
	if not inst.Name:lower():find(S.keyword, 1, true) then return false end
	return not isPlayerPart(inst)
end

local rebuildId = 0
local function rebuildBoxes()
	rebuildId += 1
	local my = rebuildId
	boxes = {}
	local i = 0
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if my ~= rebuildId then return end
		i += 1
		if i % 4000 == 0 then task.wait() end
		if matchBox(inst) then boxes[inst] = true end
	end
end

local function alive(inst)
	return inst.Parent ~= nil and inst:IsDescendantOf(Workspace)
end

local function hasBoxAncestor(inst)
	local p = inst.Parent
	while p and p ~= Workspace do
		if boxes[p] then return true end
		p = p.Parent
	end
	return false
end

-- ближайший бокс в выбранном промежутке; второй результат — сколько их всего
local function pickTarget(fromPos)
	local now = os.clock()
	local mn, mx = rangeBounds(S.pair)
	local best, bestD, count = nil, math.huge, 0
	for b in pairs(boxes) do
		if not alive(b) then
			boxes[b] = nil
		elseif not (blacklist[b] and blacklist[b] > now)
			and not hasBoxAncestor(b) and inRange(b, S.pair, mn, mx) then
			count += 1
			local d = (b:GetPivot().Position - fromPos).Magnitude
			if d < bestD then best, bestD = b, d end
		end
	end
	return best, count
end

------------------------------------------------------------
-- Действия
------------------------------------------------------------
local function setE(down)
	if down == eHeld then return end
	if down and not (S.holdE and VIM) then return end
	eHeld = down
	pcall(function() VIM:SendKeyEvent(down, Enum.KeyCode.E, false, game) end)
end

local function tpTo(hrp, pos)
	hrp.CFrame = CFrame.new(pos) * hrp.CFrame.Rotation
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
end

local function homePos()
	local k = (S.returnMode == "pair") and (2 * S.pair - 1) or 1
	local p = POINTS[k] or POINTS[1]
	return p + Vector3.new(0, 4, 0)
end

local function gatherInteractables(box)
	local prompts, clicks = {}, {}
	for _, d in ipairs(box:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			prompts[#prompts + 1] = d
		elseif d:IsA("ClickDetector") then
			clicks[#clicks + 1] = d
		end
	end
	return prompts, clicks
end

