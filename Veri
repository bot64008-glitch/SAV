-- Кнопка-«режим»: каждое нажатие — следующий вариант по кругу.
-- options: { "A", "B" } или { {id="a", label="A"}, ... }
-- spec: { Default = id, Flag =, Callback = function(id) }
function Page:AddCycle(prefix, options, spec)
	spec = spec or {}
	local win = self.Window
	local list = {}
	for _, o in ipairs(options) do
		if type(o) == "table" then
			list[#list + 1] = { id = o.id, label = o.label or tostring(o.id) }
		else
			list[#list + 1] = { id = o, label = tostring(o) }
		end
	end
	if spec.Default == nil then spec.Default = list[1].id end
	local get, set = win:_bind(prefix, spec)

	local btn = makeButton(self.Frame, "", C.card, C.text, UDim2.new(1, 0, 0, 32), win.Conns)
	btn.LayoutOrder = self:_order()
	btn.Font = Enum.Font.GothamMedium
	btn.TextSize = 12

	local function indexOf(id)
		for i, o in ipairs(list) do
			if o.id == id then return i end
		end
		return 1
	end
	local function refresh()
		btn.Text = ("%s: %s  ›"):format(prefix, list[indexOf(get())].label)
	end
	win:Track(btn.Activated:Connect(function()
		set(list[(indexOf(get()) % #list) + 1].id)
		refresh()
	end))
	refresh()
	win.Refreshers[#win.Refreshers + 1] = refresh

	return {
		Button = btn,
		Get = get,
		Set = function(id)
			set(id)
			refresh()
		end,
	}
end

