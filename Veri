	local qstroke = Instance.new("UIStroke", box)
	qstroke.Color = C.yellow
	qstroke.Transparency = 0.6

	win.Callbacks[spec.Flag or placeholder] = userCb and function(v)
		box.Text = v
		userCb(v, false)
	end or nil

	win:Track(box.FocusLost:Connect(function(enter)
		set(box.Text)
		if userCb then userCb(box.Text, enter) end
	end))
	if spec.Live then
		win:Track(box:GetPropertyChangedSignal("Text"):Connect(function()
			set(box.Text)
			if userCb then userCb(box.Text, false) end
		end))
	end
	win.Refreshers[#win.Refreshers + 1] = function()
		box.Text = get() or ""
	end

	return {
		Box = box,
		Get = function() return box.Text end,
		Set = function(t)
			box.Text = t
			set(t)
		end,
		SetVisible = function(v) box.Visible = v end,
	}
end

