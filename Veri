--[[
    ╔══════════════════════════════════════════════════════════════════╗
    ║  MenuLib — меню из WEB VALLEY STUDIO · NPC Walker v17            ║
    ║  Отдельная библиотека: подключается к любому скрипту             ║
    ╚══════════════════════════════════════════════════════════════════╝

    ЧТО ЭТО
    Тёмное меню (чёрный / серый / белый / жёлтый) с вкладками, переключателями,
    числовыми полями (− / + и ручной ввод), кнопками, выбором режима, текстовыми
    полями, перетаскиванием (мышь и палец), сворачиванием в плавающую иконку,
    счётчиком FPS и (по желанию) сохранением настроек в файл.

    ──────────────────────────────────────────────────────────────────
    ПОДКЛЮЧЕНИЕ (любой из способов)
    ──────────────────────────────────────────────────────────────────
    1) Файл в папке экзекутора (workspace):
           local MenuLib = loadstring(readfile("MenuLib.lua"))()

    2) С хостинга (GitHub raw и т.п.):
           local MenuLib = loadstring(game:HttpGet("https://.../MenuLib.lua"))()

    3) Вставить весь файл в начало своего скрипта и УДАЛИТЬ последнюю строку
       `return MenuLib` (иначе скрипт завершится на ней). Переменная MenuLib
       после этого уже доступна ниже по коду.

    ──────────────────────────────────────────────────────────────────
    БЫСТРЫЙ СТАРТ
    ──────────────────────────────────────────────────────────────────
        local Win = MenuLib.new({ Title = "МОЙ СКРИПТ", Subtitle = "STUDIO · TOOL" })
        local Main = Win:AddTab("ГЛАВНАЯ")

        Main:AddSection("НАСТРОЙКИ")
        Main:AddToggle("Автофарм", { Default = false, Callback = function(v) print(v) end })
        Main:AddNumber("Скорость", { Default = 16, Min = 1, Max = 100, Step = 1, Callback = print })
        Main:AddButton("Сделать что-то", function() print("клик") end)

    ──────────────────────────────────────────────────────────────────
    API ОКНА  (Win = MenuLib.new(opts))
    ──────────────────────────────────────────────────────────────────
    opts (все поля необязательны):
        Name       = "MenuLibGUI"   имя ScreenGui (старое окно с таким именем удаляется)
        Title      = "WEB VALLEY"   верхняя строка в шапке
        Subtitle   = "STUDIO"       нижняя (жёлтая) строка в шапке
        LogoId     = 12345          id картинки для логотипа/иконки (rbxassetid)
        Width      = 268            ширина окна
        Height     = 340            высота окна (по умолчанию подбирается под экран)
        Position   = UDim2.new(...) стартовая позиция (по умолчанию 10, 8)
        ShowFPS    = true           показывать FPS в шапке
        SaveFile   = "file.json"    включает сохранение флагов (см. ниже)
        OnClose    = function()     вызывается по кнопке ⏻ вместо Win:Destroy()

    Методы:
        Win:AddTab(name)            -> Page   (первая вкладка выбирается сама)
        Win:SelectTab(index|name)   выбрать вкладку
        Win:SetMinimized(true|false) свернуть в иконку / развернуть
        Win:SetVisible(true|false)  скрыть/показать всё меню целиком
        Win:Track(connection)       запомнить соединение — оно отключится при Destroy
        Win:Save() / Win:Load()     сохранить / загрузить флаги (нужен SaveFile)
        Win:Destroy()               полностью убрать меню и отключить все события
        Win.OnDestroy = function()  ваш колбэк очистки (останов циклов и т.п.)
        Win.Flags                   таблица значений элементов, у которых есть Flag
        Win.Alive                   true, пока меню существует (удобно для циклов)

    ──────────────────────────────────────────────────────────────────
    API ВКЛАДКИ  (Page = Win:AddTab(name))
    ──────────────────────────────────────────────────────────────────
    Page:AddSection(text)                      жёлтый заголовок раздела
    Page:AddNote(text, height)                 серая поясняющая строка (height по умолч. 28)

    Page:AddToggle(text, spec | get, set)      переключатель
    Page:AddNumber(label, spec)                число с − / + и ручным вводом
    Page:AddButton(text, callback, style)      кнопка
    Page:AddButtonRow({ {...}, {...} })        две кнопки в одну строку (СТАРТ / СТОП)
    Page:AddCycle(prefix, options, spec)       кнопка-«режим», листает варианты по кругу
    Page:AddInput(placeholder, spec)           текстовое поле
    Page:AddStatus()                           карточка «статус + информация»

    Page.OnShow = function()                   вызывается при открытии вкладки

    Два способа задать значение элемента (выберите любой):

      А) Со своим состоянием (как в оригинальном скрипте) — вы сами храните значение:
            Page:AddToggle("Прыжок", function() return state.jump end,
                                     function(v) state.jump = v end)
            Page:AddNumber("Скорость", {
                get = function() return state.speed end,
                set = function(v) state.speed = v end,
                step = 1, min = 1, max = 300, dec = 0,
            })

      Б) С Flag — значение хранит меню в Win.Flags (и может сохраняться в файл):
            Page:AddToggle("Прыжок", { Flag = "jump", Default = true,
                                       Callback = function(v) ... end })
            -- читать:   Win.Flags.jump
            -- менять:   см. объект, который вернул AddToggle (:Set(v))

    spec для AddNumber:
        Min, Max          границы (в оригинале: min, max)
        Step              шаг, число ИЛИ функция(dir, current) -> шаг
                          (dir = +1 или −1; так сделан шаг зазора: 0.1 до 2, потом 0.5)
        Dec               знаков после запятой (0 — целые)
        Default, Flag, Callback  — способ Б;   get, set — способ А

    AddButton style (необязательный): { Bg = Color3, Fg = Color3, Height = 32 }
        Готовые цвета: MenuLib.Theme.yellow / btn / card / text / white / black

    AddButtonRow: { { Text="▶ СТАРТ", Bg=yellow, Fg=black, Callback=fn },
                    { Text="■ СТОП",  Callback=fn } }  -> возвращает {btn1, btn2}

    AddCycle(prefix, options, spec):
        options = { "Один", "Два" }  или  { {id="a", label="Один"}, {id="b", label="Два"} }
        spec    = { Default = "a", Flag = "mode", Callback = function(id) end }
        Возвращает { Get(), Set(id) }. Текст кнопки: «prefix: label  ›»

    AddInput(placeholder, spec):
        spec = { Default = "", Flag = "q", Callback = function(text, enter) end,
                 Live = false }     -- Live=true: колбэк при каждом изменении текста
        Возвращает { Box, Get(), Set(text), SetVisible(bool) }

    AddStatus() -> { SetStatus(text, color), SetInfo(text, color) }

    Все AddToggle / AddNumber возвращают { Get, Set, Refresh }.
    Refresh() — перечитать значение из get() (если вы изменили состояние из кода).

    ──────────────────────────────────────────────────────────────────
    ВАЖНО
    ──────────────────────────────────────────────────────────────────
    • Обязательно вызывайте Win:Destroy() при выключении скрипта (в оригинале это
      M.shutdown) — иначе соединения событий останутся жить.
    • Чтобы ваш цикл остановился вместе с меню:  while Win.Alive do ... task.wait() end
    • Меню помещается в gethui() (если есть), иначе в PlayerGui.
    • Все свои соединения пропускайте через Win:Track(...) — тогда они отключатся сами.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local MenuLib = {}
MenuLib.__index = MenuLib

local Page = {}
Page.__index = Page

-- Палитра: чёрный / серый / белый / жёлтый. Можно менять ДО создания окна.
MenuLib.Theme = {
	bg = Color3.fromRGB(13, 13, 13),
	card = Color3.fromRGB(30, 30, 30),
	btn = Color3.fromRGB(46, 46, 46),
	line = Color3.fromRGB(56, 56, 56),
	text = Color3.fromRGB(238, 238, 238),
	sub = Color3.fromRGB(135, 135, 135),
	yellow = Color3.fromRGB(255, 204, 0),
	black = Color3.fromRGB(10, 10, 10),
	white = Color3.fromRGB(235, 235, 235),
}
local C = MenuLib.Theme

local HEADER_H = 42
local TAB_H = 28
local TOP_H = HEADER_H + TAB_H + 1

------------------------------------------------------------
-- Вспомогательное
------------------------------------------------------------
local function isPress(input)
	return input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1
end

-- Кнопка со скруглением и анимацией нажатия. bag — куда складывать соединения.
local function makeButton(parent, text, bg, fg, size, bag)
	local btn = Instance.new("TextButton")
	btn.AutoButtonColor = false
	btn.Size = size
	btn.BackgroundColor3 = bg
	btn.BorderSizePixel = 0
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.TextColor3 = fg
	btn.Text = text
	btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	local scale = Instance.new("UIScale", btn)
	bag[#bag + 1] = btn.InputBegan:Connect(function(input)
		if isPress(input) then
			TweenService:Create(scale, TweenInfo.new(0.07), { Scale = 0.95 }):Play()
		end
	end)
	bag[#bag + 1] = btn.InputEnded:Connect(function(input)
		if isPress(input) then
			TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
		end
	end)
	return btn
end

-- Логотип: сначала rbxassetid, если не загрузился — миниатюра ассета
local function applyIcon(img, id)
	img.Image = "rbxassetid://" .. id
	task.delay(4, function()
		if img.Parent and not img.IsLoaded then
			img.Image = ("rbxthumb://type=Asset&id=%d&w=150&h=150"):format(id)
		end
	end)
end

-- Перетаскивание. onTap вызывается, если это было нажатие без сдвига.
local function makeDraggable(win, handle, target, onTap)
	local dragging, dragInput, dragStart, startPos, moved = false, nil, nil, nil, false
	win:Track(handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = target.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
					if not moved and onTap then onTap() end
				end
			end)
		end
	end))
	win:Track(handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end))
	win:Track(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local d = input.Position - dragStart
			if d.Magnitude > 6 then moved = true end
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end))
end

