-- Огромный пол с коллизией. Создаётся ОДИН раз и после остановки не удаляется.
local function buildFloor()
	if farm.floorFolder and farm.floorFolder.Parent then return end
	local folder = Workspace:FindFirstChild("FarmFloorFolder")
	if folder and #folder:GetChildren() > 0 then
		farm.floorFolder = folder
		return
	end
	if folder then folder:Destroy() end

	folder = Instance.new("Folder")
	folder.Name = "FarmFloorFolder"
	local top = POINTS[1].Y - 3 -- уровень ступней персонажа
	local step = FLOOR_TILE - 8 -- небольшой нахлёст, чтобы не было щелей
	for x = -6000, 11000, step do
		for z = -6000, 6000, step do
			local part = Instance.new("Part")
			part.Name = "FarmFloor"
			part.Anchored = true
			part.CanCollide = true
			part.CanTouch = false
			part.Locked = true
			part.CastShadow = false
			part.Material = Enum.Material.SmoothPlastic
			part.Color = Color3.fromRGB(30, 30, 30)
			part.Transparency = FLOOR_TRANSPARENCY
			part.Size = Vector3.new(FLOOR_TILE, 4, FLOOR_TILE)
			part.Position = Vector3.new(x, top - 2, z)
			part.Parent = folder
		end
	end
	folder.Parent = Workspace
	farm.floorFolder = folder
end

-- Часть персонажа (свой, чужой или NPC) — коллизию у них не трогаем
local function isCharacterPart(part)
	local anc = part.Parent
	while anc and anc ~= Workspace do
		if anc:IsA("Model") and (anc:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(anc)) then
			return true
		end
		anc = anc.Parent
	end
	return false
end

local function noclipPart(part)
	if not part.CanCollide then return end
	if farm.floorFolder and part:IsDescendantOf(farm.floorFolder) then return end
	if isCharacterPart(part) then return end
	farm.collisions[part] = true
	part.CanCollide = false
end

local function restoreCollisions()
	for part in pairs(farm.collisions) do
		if part.Parent then
			pcall(function() part.CanCollide = true end)
		end
	end
	table.clear(farm.collisions)
end

-- Если часть нашего персонажа случайно попала под отключение — возвращаем
local function releaseCharacter(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and farm.collisions[d] then
			d.CanCollide = true
			farm.collisions[d] = nil
		end
	end
end

------------------------------------------------------------
-- Отслеживание объектов
------------------------------------------------------------
-- Подписка на новые объекты + полный проход по workspace:
-- собираем боксы и отключаем коллизию. Возвращает false, если фарм остановили.
local function startTracking(token)
	table.clear(farm.matched)
	table.clear(farm.blacklist)
	if farm.addedConn then farm.addedConn:Disconnect() end
	if farm.charConn then farm.charConn:Disconnect() end

	farm.addedConn = Workspace.DescendantAdded:Connect(function(d)
		if nameMatch(d) then farm.matched[d] = true end
		if d:IsA("BasePart") then noclipPart(d) end
	end)
	farm.charConn = LocalPlayer.CharacterAdded:Connect(function(char)
		task.defer(releaseCharacter, char)
	end)

	local n = 0
	for _, d in ipairs(Workspace:GetDescendants()) do
		if not (farm.running and farm.token == token) then return false end
		if nameMatch(d) then farm.matched[d] = true end
		if d:IsA("BasePart") then noclipPart(d) end
		n += 1
		if n % 2000 == 0 then task.wait() end
	end
	if LocalPlayer.Character then releaseCharacter(LocalPlayer.Character) end
	return farm.running and farm.token == token
end

local function stopTracking()
	if farm.addedConn then
		farm.addedConn:Disconnect()
		farm.addedConn = nil
	end
	if farm.charConn then
		farm.charConn:Disconnect()
		farm.charConn = nil
	end
	restoreCollisions() -- пол при этом остаётся
	table.clear(farm.matched)
	table.clear(farm.blacklist)
end

-- Все подходящие боксы в промежутке zone (между X точек zone и zone+1)
local function collectBoxes(zone)
	local ax, bx = POINTS[zone].X, POINTS[zone + 1].X
	local lo, hi = math.min(ax, bx), math.max(ax, bx)

	local chars = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then chars[p.Character] = true end
	end

	-- «Не листья»: у них внутри есть ещё один объект с "box" — берём самый глубокий
	local nonLeaf = {}
	for m in pairs(farm.matched) do
		if not inWorld(m) then
			farm.matched[m] = nil
		else
			local anc = m.Parent
			while anc and anc ~= Workspace do
				if nonLeaf[anc] then break end
				nonLeaf[anc] = true
				anc = anc.Parent
			end
		end
	end

	local now = os.clock()
	local list = {}
	for m in pairs(farm.matched) do
		if not nonLeaf[m] then
			local skip = false
			local until_t = farm.blacklist[m]
			if until_t then
				if until_t > now then skip = true else farm.blacklist[m] = nil end
			end
			if not skip then
				local anc = m
				while anc and anc ~= Workspace do
					if chars[anc] then skip = true break end
					anc = anc.Parent
				end
			end
			if not skip then
				local p = posOf(m)
				if p and p.X >= lo and p.X <= hi then
					list[#list + 1] = { inst = m, pos = p }
				end
			end
		end
	end
	return list
end

-- Ближайший к точке from бокс и общее число боксов в промежутке
local function pickBox(zone, from)
	local list = collectBoxes(zone)
	local best, bd
	for _, e in ipairs(list) do
		local d = (e.pos - from).Magnitude
		if not bd or d < bd then
			best, bd = e, d
		end
	end
	return best, #list
end

local function findPrompt(inst)
	if inst:IsA("ProximityPrompt") then return inst end
	local p = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
	if p then return p end
	local par = inst.Parent
	if par and par ~= Workspace and par:IsA("Model") and nameMatch(par) then
		return par:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
end

------------------------------------------------------------
-- Движение
------------------------------------------------------------
-- Применяем движение ПОСЛЕ стандартного управления (джойстик / WASD),
-- иначе оно перезаписывает Humanoid:Move каждый кадр.
pcall(function() RunService:UnbindFromRenderStep("BoxFarmMove") end)
RunService:BindToRenderStep("BoxFarmMove", Enum.RenderPriority.Last.Value + 1, function()
	if not farm.running then return end
	local _, hum = getChar()
	if not hum then return end
	if Win.Flags.mode == "run" then
		hum.WalkSpeed = Win.Flags.speed
	elseif farm.origSpeed then
		hum.WalkSpeed = farm.origSpeed
	end
	hum:Move(farm.move or Vector3.zero, false)
end)

-- Один шаг к цели по горизонтали. true — дошли (подошли на stopDist).
local function stepToward(root, target, stopDist, dt)
	local delta = target - root.Position
	local flat = Vector3.new(delta.X, 0, delta.Z)
	local dist = flat.Magnitude
	if dist <= stopDist then
		farm.move = nil
		return true
	end
	local remain = dist - stopDist
	local travel = Win.Flags.speed * dt
	local dir = flat.Unit
	local cframeMode = Win.Flags.mode == "cframe"

	if cframeMode or remain <= travel * 1.25 then
		-- в режиме CFrame двигаемся сами; в режиме бега — «докатываем» остаток, чтобы не промахнуться на 700
		local adv = cframeMode and math.min(remain, travel) or remain
		local pos = root.Position + dir * adv
		root.CFrame = CFrame.lookAt(pos, pos + dir)
		root.AssemblyLinearVelocity = Vector3.zero
		farm.move = nil
		return adv >= remain - 0.001
	end

	farm.move = dir
	return false
end

local statusCard -- создаётся ниже
local function ui(text, color, info)
	if statusCard then
		statusCard.SetStatus(text, color)
		statusCard.SetInfo(info or "")
	end
end

-- Бег к точке. onFrame(root) -> true прерывает бег.
-- Возвращает "arrived" | "interrupt" | "stopped"
local function runTo(token, target, stopDist, onFrame)
	while farm.running and farm.token == token and Win.Alive do
		local dt = RunService.Heartbeat:Wait()
		local _, _, root = getChar()
		if not root then
			farm.move = nil
			task.wait(0.2)
			continue
		end
		if onFrame and onFrame(root) then
			farm.move = nil
			return "interrupt"
		end
		if stepToward(root, target, stopDist, dt) then
			return "arrived"
		end
	end
	farm.move = nil
	return "stopped"
end

------------------------------------------------------------
-- Работа с одним боксом
------------------------------------------------------------
local function engage(token, zone, entry)
	local inst = entry.inst
	local first = POINTS[zone]
	local lockPos = entry.pos
	local t0 = os.clock()
	local prompt = findPrompt(inst)
	local stopDist = prompt and math.clamp(prompt.MaxActivationDistance * 0.5, 3, 8) or 4
	local lastFire = 0

	ui("Бегу к боксу", C.yellow, zoneText(zone))
	setE(true)

	while farm.running and farm.token == token and Win.Alive do
		local dt = RunService.Heartbeat:Wait()
		local _, _, root = getChar()
		if not root then
			farm.move = nil
			setE(false)
			return
		end
		if currentZone() ~= zone then
			farm.move = nil
			setE(false)
			return
		end
		if not inWorld(inst) then -- бокс исчез (подобран)
			farm.move = nil
			setE(false)
			return
		end
		local p = posOf(inst)
		if not p then
			farm.move = nil
			setE(false)
			return
		end

		-- бокс сдвинулся хоть чуть-чуть → в первую точку промежутка
		if (p - lockPos).Magnitude > Win.Flags.threshold then
			farm.move = nil
			setE(false)
			ui("Бокс сдвинулся", C.yellow, ("Бег к точке %d"):format(zone))
			runTo(token, first, 3)
			return
		end

		-- не получается подобрать — пропускаем на 15 секунд
		if os.clock() - t0 > Win.Flags.timeout then
			farm.blacklist[inst] = os.clock() + 15
			farm.move = nil
			setE(false)
			return
		end

		local arrived = stepToward(root, p, stopDist, dt)
		if arrived and prompt and fireproximityprompt and os.clock() - lastFire > 0.25 then
			lastFire = os.clock()
			pcall(fireproximityprompt, prompt)
		end
	end
	farm.move = nil
	setE(false)
end

------------------------------------------------------------
-- Главный цикл
------------------------------------------------------------
local stopFarm

local function farmLoop(token)
	while farm.running and farm.token == token and Win.Alive do
		local _, _, root = getChar()
		if not root then
			farm.move = nil
			setE(false)
			task.wait(0.3)
			continue
		end

		local zone = currentZone()
		local first = POINTS[zone]
		local entry, count = pickBox(zone, root.Position)

		if entry then
			ui("Бокс найден", C.yellow, ("%s · боксов: %d"):format(zoneText(zone), count))
			engage(token, zone, entry)
		else
			setE(false)
			ui("Зона пуста", C.white, ("%s · жду у точки %d"):format(zoneText(zone), zone))

			local nextScan = 0
			local res = runTo(token, first, 3, function(r)
				if currentZone() ~= zone then return true end
				if os.clock() < nextScan then return false end
				nextScan = os.clock() + 0.2
				return (pickBox(zone, r.Position)) ~= nil
			end)

			if res == "arrived" then
				if Win.Flags.stopEmpty then
					task.wait(1) -- даём боксам прогрузиться
					if farm.running and farm.token == token and not (pickBox(zone, first)) then
						stopFarm("Зона очищена")
						return
					end
				else
					task.wait(0.2)
				end
			end
		end
	end
end

local function startFarm()
	if farm.running or not Win.Alive then return end
	local _, hum = getChar()
	if hum then farm.origSpeed = hum.WalkSpeed end
	farm.running = true
	farm.token += 1
	local token = farm.token

	task.spawn(function()
		local function alive()
			return farm.running and farm.token == token and Win.Alive
		end

		-- 1) пол (один раз) → 2) отключение коллизии у всего остального
		ui("Подготовка", C.yellow, "Пол и отключение коллизии…")
		buildFloor()
		if not startTracking(token) then return end

		-- 3) обязательно встаём в позицию 1, если игрок на X <= 157
		local root
		while alive() do
			local _, _, r = getChar()
			if r then root = r break end
			task.wait(0.2)
		end
		if not alive() then return end

		local tries = 0
		while alive() and root and root.Position.X <= START_X_LIMIT and tries < 8 do
			tries += 1
			ui("Старт", C.yellow, "Встаю в позицию 1")
			root.CFrame = CFrame.lookAt(POINTS[1], POINTS[1] + Vector3.xAxis)
			root.AssemblyLinearVelocity = Vector3.zero
			task.wait(0.3)
			local _, _, r = getChar()
			root = r or root
		end
		if not alive() then return end

		-- 4) только теперь начинается фарм
		farmLoop(token)
	end)
end

function stopFarm(reason)
	if not farm.running then return end
	farm.running = false
	farm.token += 1
	farm.move = nil
	setE(false)
	stopTracking()
	local _, hum = getChar()
	if hum and farm.origSpeed then hum.WalkSpeed = farm.origSpeed end
	if Win.Alive then
		ui("Остановлено", MenuLib.Theme.sub, reason or "")
	end
end

